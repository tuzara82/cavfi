# Copy to .env and fill in. Never put a key with real funds here.
# Leave PRIVATE_KEY empty: the bot asks for it (hidden) at start.
PRIVATE_KEY=

# Telegram: create a bot with @BotFather, send it a message, then get your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates  (field "chat":{"id": ...})
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# What the bot does (1 = on, 0 = off)
FILL_LIMITS=1
REBALANCE=1
RETURN_EXPIRED=0

# Rebalancer limits
REBALANCE_MIN_PCT=3
REBALANCE_MAX_USD=50
GAS_RESERVE_DOGE=1
# pools smaller than this (USD) are ignored as price evidence
REBALANCE_MIN_POOL_USD=1

# Telegram alert for swaps worth at least this many USD (0 = off)
NOTIFY_SWAP_USD=25

INTERVAL_SEC=30
# DRY_RUN=1 only logs what it would do
