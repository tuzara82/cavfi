# Copy to .env and fill in. Never put a key with real funds here.
# Leave PRIVATE_KEY empty: the bot asks for it (hidden) at start.
PRIVATE_KEY=

# Telegram: create a bot with @BotFather, send it a message, then get your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates  (field "chat":{"id": ...})
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# What the bot does (1 = on, 0 = off)
FILL_LIMITS=1
REBALANCE=1
RETURN_EXPIRED=0

# Rebalancer limits
REBALANCE_MIN_PCT=3
REBALANCE_MAX_USD=50
GAS_RESERVE_DOGE=1
# pools smaller than this (USD) are ignored as price evidence
REBALANCE_MIN_POOL_USD=1

# Telegram alert for swaps worth at least this many USD (0 = off)
NOTIFY_SWAP_USD=25

INTERVAL_SEC=30
# DRY_RUN=1 only logs what it would do

# RedStone API key for Predict/Guess v2 (the public gateways close on 2026-10-29).
# Ask RedStone for a key (docs.redstone.finance -> Pull model -> "fill out this form").
REDSTONE_API_KEY=
# optional: a second gateway/key pair as fallback, or another gateway url
# REDSTONE_GATEWAY_URL=https://oracle-gateway.a.redstone.finance
# REDSTONE_API_KEY_2=
# REDSTONE_GATEWAY_URL_2=
